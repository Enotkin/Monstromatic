<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Monstromatic.Views;assembly=Monstromatic"
        xmlns:vm="clr-namespace:Monstromatic.ViewModels;assembly=Monstromatic"
        xmlns:conv="clr-namespace:Monstromatic.Converters;assembly=Monstromatic"
        mc:Ignorable="d"
        x:Class="Monstromatic.Views.EncounterView"
        Design.DataContext="{Binding Source={StaticResource DesignVmLocator}, Path=EncounterViewModel}"
        SystemDecorations="BorderOnly"
        CanResize="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaToDecorationsHint="True"
        Width="350" MaxWidth="450" MinWidth="450">
    <Window.Resources>
        <conv:DoubleToGridLengthConverter x:Key="GridLengthConverter"/>
        <conv:GridHeightFeatureCountConverter x:Key="FeatureCountConverter" />
    </Window.Resources>
    
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
    </Window.Styles>
    
    <Border Name="Border" BorderThickness="2">
        <Grid VerticalAlignment="Top" RowDefinitions="Auto,*">

            <!-- Headers -->
            <Grid Grid.Row="0" VerticalAlignment="Top" RowDefinitions="Auto">
                <Border>
                    <Border.BorderThickness>2</Border.BorderThickness>
                    <Border.CornerRadius>10, 10, 0, 0</Border.CornerRadius>
                </Border>

                <Grid Grid.Row="0"
                      Name="Header"
                      Background="Transparent"
                      PointerPressed="Header_PointerPressed"
                      ColumnDefinitions="*,40"
                      RowDefinitions="34,34">

                    <!-- Styles -->
                    <Grid.Styles>
                        <Style Selector="Button.header-small">
                            <Setter Property="Width" Value="26" />
                            <Setter Property="Height" Value="24" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="9" />
                        </Style>
                        <Style Selector="TextBlock.header-text">
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Style>
                    </Grid.Styles>

                    <!-- Monster name -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Classes="header-text"
                               Margin="8,2"
                               Text="{Binding Name}"
                               TextWrapping="Wrap" />

                    <!-- Encounter controls -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="3">
                            <Button Classes="header-small"
                                    Command="{Binding RemoveLevelCommand}">&lt;&lt;</Button>
                            <TextBlock Classes="header-text"
                                       MinWidth="38"
                                       Text="{Binding Level, StringFormat=Ур. \{0\}}" />
                            <Button Classes="header-small"
                                    Command="{Binding AddLevelCommand}">&gt;&gt;</Button>
                        </StackPanel>

                        <Button Classes="header-small"
                                Command="{Binding ResetModificationsCommand}"
                                Content="R"
                                ToolTip.Tip="Сбросить изменения" />

                        <Button Name="AddToBestiaryButton"
                                Classes="header-small"
                                Command="{Binding AddToBestiaryCommand}"
                                IsVisible="{Binding CanAddToBestiary}"
                                ToolTip.Tip="Добавить в бестиарий">
                            <Path Width="14"
                                  Height="14"
                                  Data="M 2 1 L 13 1 L 17 5 L 17 17 L 1 17 L 1 1 Z M 4 1 L 4 7 L 13 7 L 13 1 M 4 17 L 4 11 L 14 11 L 14 17"
                                  Stroke="{StaticResource ThemeControlHighlightLowBrush}"
                                  StrokeThickness="1.5" />
                        </Button>

                        <!-- Color selecting -->
                        <ComboBox Width="44"
                                  Height="28"
                                  Name="ColorSelector"
                                  SelectionChanged="ColorSelectorOnSelectionChanged">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="20" Height="20" Margin="3" Stroke="Black" StrokeThickness="1" Fill="{Binding $parent.Content}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Two-row close button -->
                    <Button Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="CloseButton_Click"
                            Background="#bb0000"
                            ToolTip.Tip="Закрыть">
                        <Path Width="16"
                              Height="16"
                              Data="M 1 1 L 15 15 M 1 15 L 15 1"
                              Stroke="{StaticResource ThemeControlHighlightLowBrush}"
                              StrokeThickness="2" />
                    </Button>
                </Grid>

            </Grid>

            <!-- Monsters-->
            <Grid Grid.Row="1" Name="ExpandableGrid" VerticalAlignment="Stretch">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Row="0" Margin="5, 5,5,0 " ColumnDefinitions="*">
                    
                    <Grid ColumnDefinitions="*, Auto" >
                                            
                        <Border BorderBrush="{StaticResource ThemeControlHighlightLowBrush}" 
                                BorderThickness="2" CornerRadius="5" Margin="0, 0, 5, 0">
                            <ItemsControl VerticalAlignment="Stretch" ItemsSource="{Binding DescriptiveFeatures}">
                
                                <ItemsControl.Styles>
                                    <Style Selector="TextBlock:pointerover">
                                        <Setter Property="Background" Value="{StaticResource ThemeControlLowBrush}"/>
                                    </Style>
                                </ItemsControl.Styles>
                
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,3,0,3" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding Description}" ToolTip.Tip="{Binding Description}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                
                            </ItemsControl>
                        </Border>
                        
                        <!-- ������ ���������� ������� -->
                        <Border Grid.Column="1" BorderBrush="{StaticResource ThemeControlHighlightLowBrush}" 
                                BorderThickness="2" CornerRadius="5" Padding="5">
                            <Grid  ColumnDefinitions="*, *">
                                <Label Grid.Column="0" Content="{Binding Monsters.Count}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="5, 0, 5, 0" Orientation="Vertical" VerticalAlignment="Center" Spacing="5">
                                    <Button Command="{Binding AddMonsterCommand}" Width="30" Height="19" Content="+" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0"/>
                                    <Button Command="{Binding RemoveMonsterCommand}" Width="30" Height="19" Content="-" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                    </Grid>
                </Grid>
                
                <!-- ������ ����������� ��������-->
                <Grid Grid.Row="1" Margin="0, 15, 0, 10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="MonsterItemControl" ItemsSource="{Binding Monsters}">
                    
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="5, 0"></StackPanel>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                    
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MonsterViewModel}">
                                    <views:MonsterView Margin="0, 5, 0, 5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                    
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
            
        </Grid>
    </Border>
</Window>
