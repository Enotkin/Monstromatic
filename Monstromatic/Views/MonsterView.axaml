<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Monstromatic.Views;assembly=Monstromatic"
             xmlns:viewModels="clr-namespace:Monstromatic.ViewModels"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="200"
             x:Class="Monstromatic.Views.MonsterView"
             x:DataType="viewModels:MonsterViewModel"
             Design.DataContext="{Binding Source={StaticResource DesignVmLocator}, Path=MonsterViewModel}">
    
    <UserControl.Styles>
        <StyleInclude Source="/Styles/HeaderStyles.axaml"></StyleInclude>
    </UserControl.Styles>

    <Grid>
        <Border Name="Border" BorderThickness="2" BorderBrush="#FFA0A0A0" CornerRadius="5">
            <DockPanel LastChildFill="True">

                <Border DockPanel.Dock="Top" Background="#FFA0A0A0" CornerRadius="3,3,0,0" >
                    <Grid VerticalAlignment="Top" RowDefinitions="*" ColumnDefinitions="*" Margin="0, 5">

                        <Border>
                            <Border.BorderThickness>2</Border.BorderThickness>
                            <Border.CornerRadius>10, 10, 0, 0</Border.CornerRadius>
                        </Border>

                        <Grid Grid.Row="0" Name="Header" ColumnDefinitions="Auto, Auto, *,Auto">
                        
                            <Grid.Styles>
                                <Style Selector="Button">
                                    <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
                                    <Setter Property="Margin" Value="3, 0"></Setter>
                                </Style>
                                <Style Selector="ToggleButton">
                                    <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
                                    <Setter Property="Margin" Value="3, 0"></Setter>
                                    <Setter Property="FontSize" Value="16"></Setter>
                                    <Setter Property="FontWeight" Value="Bold"></Setter>
                                </Style>
                            </Grid.Styles>
                        
                            <!-- <Кнопка раскрытия окна> -->
                            <Button Name="HideButton" Grid.Column="0" Classes="round" Click="ChangeExpandState"
                                    Margin="5, 0, 0, 0 "
                                    Background="{StaticResource MonstromaticAccent}">
                                <Button.RenderTransform>
                                    <RotateTransform Angle="0">
                                        <RotateTransform.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Angle" Duration="0:0:0.1" Easing="SplineEasing"/>
                                            </Transitions>
                                        </RotateTransform.Transitions>
                                    </RotateTransform>
                                </Button.RenderTransform>
                        
                                <Path Data="M 0 5 L 5 0 L 10 5" Stroke="{StaticResource ThemeControlHighlightLowBrush}"
                                      StrokeThickness="2">
                                </Path>
                            </Button>

                            <!-- Название монстра -->
                            <TextBlock Grid.Column="1"
                                       Text="▲"
                                       Foreground="#FF39FF14"
                                       FontSize="24"
                                       FontWeight="Black"
                                       Margin="8,0,2,0"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsBoosted}"
                                       ToolTip.Tip="Характеристики повышены"/>
                            
                            <Border Grid.Column="2"
                                    Background="Transparent"
                                    PointerPressed="MonsterName_OnPointerPressed"
                                    ToolTip.Tip="Дважды щёлкните, чтобы изменить название">
                                <Grid>
                                    <TextBlock Name="MonsterNameText"
                                               Text="{Binding Name}"
                                               Classes="main"
                                               HorizontalAlignment="Center"
                                               Margin="2, 2, 2, 5"
                                               TextWrapping="Wrap"/>

                                    <TextBox Name="MonsterNameEditor"
                                             Text="{Binding EditableName, Mode=TwoWay}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Margin="2, 0, 2, 3"
                                             IsVisible="False"
                                             LostFocus="MonsterNameEditor_OnLostFocus"
                                             KeyDown="MonsterNameEditor_OnKeyDown"/>
                                </Grid>
                            </Border>
                            
                        
                            <!-- Кнопки управления -->
                            <Grid Grid.Column="3" Margin="0, 0, 0, 0 " ColumnDefinitions="*, *, *, *, *" HorizontalAlignment="Center" >
                            
                                <NumericUpDown Grid.Column="0" 
                                               Value="{Binding Levell, Mode=TwoWay}" 
                                               Increment="2"
                                               FormatString="0"
                                               Minimum="0"
                                               IsEnabled="True" IsReadOnly="False">
                                    <NumericUpDown.Styles>
                                        <Style Selector="RepeatButton">
                                            <Setter Property="MinWidth" Value="28" />
                                            <Setter Property="MinHeight" Value="16" />
                                        </Style>
                                    </NumericUpDown.Styles>
                                    <NumericUpDown.InnerLeftContent>
                                        <TextBlock Text="Ур. " />
                                    </NumericUpDown.InnerLeftContent>
                                </NumericUpDown>
                            
                                <ToggleButton Grid.Column="1"
                                              IsCheckedChanged="DeathToggleButton_OnIsCheckedChanged"
                                              Content="☠"
                                              ToolTip.Tip="Отметить монстра" />

                                <Button Grid.Column="2"
                                        Command="{Binding BoostSkillsCommand}"
                                        Content="▲"
                                        IsEnabled="{Binding !IsBoosted}"
                                        ToolTip.Tip="Повысить характеристики" />

                                <!-- <Button Grid.Column="0"  Command="{Binding RemoveLevelCommand}" Content="&lt;&lt;" /> -->
                                <!-- <TextBlock Grid.Column="1" Classes="main" Text="{Binding Level, StringFormat=Ур. \{0\}}" VerticalAlignment="Center"/> -->
                                <!-- <Button Grid.Column="2"  Command="{Binding AddLevelCommand}" Content="&gt;&gt;" /> -->
                            
                                <Button Grid.Column="3"  Command="{Binding ResetModificationsCommand}" Content="R" />

                                <!-- Закрыте окна -->
                                <Button Grid.Column="4"  Command="{Binding CloseCommand}" Background="#bb0000">
                                    <Path Data="M 0 0 L 10 10 M 0 10 L 10 0"
                                          Stroke="{StaticResource ThemeControlHighlightLowBrush}" StrokeThickness="2">
                                    </Path>
                                </Button>
                            </Grid>
                    
                        </Grid>
                    </Grid>
                </Border>

                <ItemsControl Name="ExpanderGrid"
                              ItemsSource="{Binding SkillsVm}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ClipToBounds="True">
                
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:SkillLensPanel Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:SkillCounterView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                
                </ItemsControl>
            
            </DockPanel>
        </Border>
        
        <Border Name="DeathOverlay"
                BorderThickness="2"
                BorderBrush="#99BB0000"
                Background="#66BB0000"
                CornerRadius="5"
                IsHitTestVisible="False"
                IsVisible="False" />
    </Grid>
</UserControl>
