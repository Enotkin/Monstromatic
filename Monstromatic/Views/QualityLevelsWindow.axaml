<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="520"
        d:DesignHeight="540"
        x:Class="Monstromatic.Views.QualityLevelsWindow"
        Title="Стартовые уровни"
        Width="520"
        Height="540"
        MinWidth="460"
        MinHeight="420"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.icon-button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="22">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,18">
            <TextBlock Text="Стартовые уровни"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Качества монстра и уровень, с которого такой монстр начинается"
                       Opacity="0.72"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Qualities}" Margin="0,0,8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="12,10"
                                BorderBrush="{StaticResource ThemeControlHighlightLowBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                <TextBox Grid.Row="0"
                                         Grid.Column="0"
                                         Height="34"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Text="{Binding Name}"
                                         Watermark="Например: Мини-Босс"
                                         MaxLength="60" />
                                <NumericUpDown Grid.Row="0"
                                               Grid.Column="1"
                                               Width="110"
                                               Height="34"
                                               VerticalAlignment="Center"
                                               Value="{Binding Level}"
                                               Increment="2"
                                               Minimum="2"
                                               Maximum="200"
                                               FormatString="0"
                                               ToolTip.Tip="Стартовый уровень монстра" />
                                <Button Grid.Row="0"
                                        Grid.Column="2"
                                        Width="34"
                                        Height="34"
                                        Margin="7,0,0,0"
                                        Padding="6"
                                        VerticalAlignment="Center"
                                        Command="{Binding RemoveCommand}"
                                        ToolTip.Tip="Убрать качество">
                                    <Path Data="M 2 2 L 12 12 M 12 2 L 2 12"
                                          Stroke="{StaticResource ThemeControlHighlightLowBrush}"
                                          StrokeThickness="2" />
                                </Button>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           Margin="0,6,0,0"
                                           Text="{Binding ValidationMessage}"
                                           Foreground="#E98B8B"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2"
                Height="38"
                Margin="0,6,8,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                CornerRadius="4"
                Command="{Binding AddQualityCommand}"
                ToolTip.Tip="Добавить качество">
            <Path Width="16"
                  Height="16"
                  Data="M 8 1 L 8 15 M 1 8 L 15 8"
                  Stroke="{StaticResource ThemeControlHighlightLowBrush}"
                  StrokeThickness="2" />
        </Button>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding ValidationMessage}"
                       Foreground="#E98B8B"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9">
                <Button Classes="icon-button"
                        IsEnabled="{Binding CanSave}"
                        Click="SaveButton_OnClick"
                        ToolTip.Tip="{Binding ConfirmButtonTooltip}">
                    <Path Width="18"
                          Height="14"
                          Data="M 1 7 L 6 12 L 17 1"
                          Stroke="{StaticResource ThemeControlHighlightLowBrush}"
                          StrokeThickness="2.2" />
                </Button>
                <Button Classes="icon-button"
                        Click="CancelButton_OnClick"
                        ToolTip.Tip="Закрыть без сохранения">
                    <Path Width="16"
                          Height="16"
                          Data="M 1 1 L 15 15 M 15 1 L 1 15"
                          Stroke="{StaticResource ThemeControlHighlightLowBrush}"
                          StrokeThickness="2" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
