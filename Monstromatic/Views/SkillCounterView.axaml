<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Monstromatic.ViewModels"
             xmlns:utils="clr-namespace:Monstromatic.Utils"
             mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="100"
             x:Class="Monstromatic.Views.SkillCounterView"
             x:DataType="viewModels:SkillCounterViewModel"
             Design.DataContext="{Binding Source={StaticResource DesignVmLocator}, Path=SkillCounterViewModel}">
    
    <UserControl.Resources>
        <utils:ModificatorTextConverter x:Key="ModificatorTextConverter" />
        <utils:ModificatorColorConverter x:Key="ModificatorColorConverter" />
    </UserControl.Resources>
    
    <!--
        Every skill is designed at one reference size and then scaled as a whole.
        The parent UniformGrid gives each skill 1/N of the available row width,
        so three skills are larger than four, four are larger than five, and so on.
    -->
    <Viewbox Stretch="Uniform"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Margin="0, 10">
        <Grid Width="140"
              Height="78"
              RowDefinitions="26,*">
            <Border Background="Transparent"
                    ToolTip.Tip="{Binding CommentsToolTipText}">
                <TextBlock Text="{Binding SkillName}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           MaxLines="2"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,28">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentSkillValue"
                               Text="{Binding SkillValue}"
                               Foreground="{Binding Modificator, Converter={StaticResource ModificatorColorConverter}}"
                               FontSize="44"
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding Modificator, Converter={StaticResource ModificatorTextConverter}, Mode=OneWay}"
                               Foreground="{Binding Modificator, Converter={StaticResource ModificatorColorConverter}}"
                               FontSize="18"
                               VerticalAlignment="Bottom"
                               Margin="2,0,0,7" />
                </StackPanel>

                <!-- The reset button overlays the value without participating in its layout. -->
                <Button Grid.Column="0"
                        Width="38"
                        Height="26"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Content="R"
                        FontSize="16"
                        FontWeight="Bold"
                        Command="{Binding Reset}"
                        ToolTip.Tip="Сбросить изменение навыка" />

                <Grid Grid.Column="1"
                      Height="48"
                      RowDefinitions="*,*"
                      VerticalAlignment="Center">
                    <Button Grid.Row="0"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            Margin="0,0,0,1"
                            Content="+"
                            FontSize="18"
                            FontWeight="Bold"
                            Command="{Binding Increase}" />
                    <Button Grid.Row="1"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            Margin="0,1,0,0"
                            Content="-"
                            FontSize="18"
                            FontWeight="Bold"
                            Command="{Binding Decrease}" />
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
