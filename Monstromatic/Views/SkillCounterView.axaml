<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Monstromatic.ViewModels"
             xmlns:utils="clr-namespace:Monstromatic.Utils"
             mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="100"
             x:Class="Monstromatic.Views.SkillCounterView"
             x:DataType="viewModels:SkillCounterViewModel"
             Design.DataContext="{Binding Source={StaticResource DesignVmLocator}, Path=SkillCounterViewModel}">
    
    <UserControl.Resources>
        <utils:ModificatorTextConverter x:Key="ModificatorTextConverter" />
        <utils:ModificatorColorConverter x:Key="ModificatorColorConverter" />
    </UserControl.Resources>
    
    <StackPanel>
        <Border Height="34"
                Background="Transparent"
                ToolTip.Tip="{Binding CommentsToolTipText}">
            
            <TextBlock Text="{Binding SkillName}"
                       HorizontalAlignment="Stretch"
                       FontSize="12"
                       Foreground="white"
                       MaxLines="2"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Border>
        
        <Grid ColumnDefinitions="*, Auto">
            
            <Grid RowDefinitions="*, *" ColumnDefinitions="*, *, *" >
                <Button Grid.Row="0" Grid.Column="2" Background="Transparent" Content="R" BorderBrush="Transparent" Opacity="200" Command="{Binding Reset}"></Button>
            </Grid>
            
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock x:Name="CurrentSkillValue"
                           Text="{Binding SkillValue}"
                           Foreground="{Binding Modificator, Converter={StaticResource ModificatorColorConverter}}"
                           FontSize="32"
                           VerticalAlignment="Center" />

                <TextBlock Text="{Binding Modificator, Converter={StaticResource ModificatorTextConverter}, Mode=OneWay}"
                           Foreground="{Binding Modificator, Converter={StaticResource ModificatorColorConverter}}"
                           FontSize="13"
                           VerticalAlignment="Bottom"
                           Margin="2,0,0,6" />
            </StackPanel>
            
            <Grid Grid.Column="1" RowDefinitions="Auto, Auto" Margin="0, 0, 5, 0">
                <Button Grid.Row="0" Content="+" Command="{Binding Increase}" Margin="0, 0, 0, 2"/>
                <Button Grid.Row="1" Content="-" Command="{Binding Decrease}" Margin="0, 1, 0, 0" />
            </Grid>
            
        </Grid>
        
        <UniformGrid Rows="2" Columns="2">
            
            <UniformGrid.Styles>
                <Style Selector="TextBox">
                    <Setter Property="Margin" Value="2"></Setter>
                </Style>
                
                <Style Selector="Button">
                    <Setter Property="Margin" Value="2"></Setter>

                    <Setter Property="FontWeight" Value="Bold"></Setter>
                </Style>
                
            </UniformGrid.Styles>
        </UniformGrid>
    </StackPanel>
</UserControl>
