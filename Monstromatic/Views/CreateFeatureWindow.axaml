<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="520"
        d:DesignHeight="570"
        x:Class="Monstromatic.Views.CreateFeatureWindow"
        Title="Создать особенность"
        Width="520"
        Height="570"
        MinWidth="460"
        MinHeight="500"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.form-label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown.modifier-input">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon-button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="22">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,18">
            <TextBlock Text="Создать особенность"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Задайте название и нужные модификаторы"
                       Opacity="0.72" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Margin="0,0,8,8">
                <StackPanel Spacing="5">
                    <TextBlock Classes="form-label" Text="Название особенности" />
                    <TextBox Text="{Binding Name}"
                             Watermark="Например: Каменная броня"
                             MaxLength="120" />
                    <TextBlock Text="{Binding NameValidationMessage}"
                               Foreground="#E98B8B"
                               FontSize="12" />
                </StackPanel>

                <ComboBox ItemsSource="{Binding AvailableModifierOptions}"
                          SelectedItem="{Binding SelectedModifierOption}"
                          IsEnabled="{Binding CanAddModifier}"
                          PlaceholderText="Добавить модификатор">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ItemsControl ItemsSource="{Binding Modifiers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Classes="form-label"
                                           Text="{Binding DisplayName}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,10,0" />
                                <NumericUpDown Grid.Row="0"
                                               Grid.Column="1"
                                               Classes="modifier-input"
                                               Value="{Binding Modifier}"
                                               Increment="{Binding Increment}"
                                               Minimum="-100"
                                               Maximum="100"
                                               FormatString="{Binding FormatString}" />
                                <Button Grid.Row="0"
                                        Grid.Column="2"
                                        Width="34"
                                        Height="34"
                                        Margin="7,0,0,0"
                                        Padding="6"
                                        VerticalAlignment="Center"
                                        Command="{Binding RemoveCommand}"
                                        ToolTip.Tip="Убрать модификатор">
                                    <Path Data="M 2 2 L 12 12 M 12 2 L 2 12"
                                          Stroke="{StaticResource ThemeControlHighlightLowBrush}"
                                          StrokeThickness="2" />
                                </Button>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Margin="0,4,0,0"
                                           Text="{Binding ValidationMessage}"
                                           Foreground="#E98B8B"
                                           FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="5">
                    <TextBlock Classes="form-label" Text="Добавить комментарий" />
                    <TextBox Text="{Binding Comment}"
                             Watermark="Введите комментарий"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="90"
                             MaxLength="1000" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="9"
                    Margin="0,16,0,0">
            <Button Classes="icon-button"
                    IsEnabled="{Binding CanSave}"
                    Click="SaveButton_OnClick"
                    ToolTip.Tip="Сохранить">
                <Path Width="18"
                      Height="14"
                      Data="M 1 7 L 6 12 L 17 1"
                      Stroke="{StaticResource ThemeControlHighlightLowBrush}"
                      StrokeThickness="2.2" />
            </Button>
            <Button Classes="icon-button"
                    Click="CancelButton_OnClick"
                    ToolTip.Tip="Закрыть без сохранения">
                <Path Width="16"
                      Height="16"
                      Data="M 1 1 L 15 15 M 15 1 L 1 15"
                      Stroke="{StaticResource ThemeControlHighlightLowBrush}"
                      StrokeThickness="2" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
