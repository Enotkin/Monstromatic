<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="480"
        d:DesignHeight="300"
        x:Class="Monstromatic.Views.MessageWindow"
        Title="Monstromatic"
        Width="480"
        Height="300"
        MinWidth="420"
        MinHeight="240"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="22">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,14">
            <TextBlock Name="HeadingTextBlock"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Name="SubtitleTextBlock"
                       Opacity="0.72"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock Name="BodyTextBlock"
                       TextWrapping="Wrap"
                       LineHeight="22" />
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="9"
                    Margin="0,16,0,0">
            <Button Name="ConfirmButton"
                    MinWidth="90"
                    Height="36"
                    Click="ConfirmButton_OnClick" />
            <Button Name="CancelButton"
                    MinWidth="90"
                    Height="36"
                    Click="CancelButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
